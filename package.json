{
  "name": "geojson-map-studio",
  "description": "A lightweight browser workspace for turning GeoJSON boundaries and optional business data into polished technology-style maps.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen:mocks": "node scripts/gen-district-mocks.mjs",
    "gen:map": "node scripts/geojson-to-svg.mjs",
    "geojson:catalog": "node scripts/build-region-catalog.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "echarts": "^5.6.0",
    "lucide-vue-next": "^1.0.0",
    "three": "^0.185.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "20.10.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.2.0"
  }
}
